# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Primary blockchain provider
BLOCKCHAIN_PROVIDER="chainstack"

# Chainstack network configuration
CHAINSTACK_NETWORK="base"
CHAINSTACK_RPC_URL="https://your-chainstack-rpc-endpoint"
# Optional: enables subscription/event functionality only. HTTPS above is the
# primary transport and connectivity does not depend on this being set.
CHAINSTACK_WSS_URL="wss://your-chainstack-websocket-endpoint"
CHAINSTACK_CHAIN_ID="8453"
CHAINSTACK_API_KEY=""
CHAINSTACK_PROJECT_ID=""
CHAINSTACK_NODE_ID=""
# Leave empty for MVP: server-side signing is disabled by default and read-only
# RPC connectivity does not require a private key or wallet address.
CHAINSTACK_PRIVATE_KEY=""
CHAINSTACK_WALLET_ADDRESS=""
CHAINSTACK_NATIVE_CURRENCY="ETH"
CHAINSTACK_RPC_TIMEOUT_MS="15000"

# Live feed strict mode: when true, do not silently fall back to demo data
LIVE_FEED_STRICT="true"

# Standardized application data mode: "live", "demo", or "test"
# In live mode + LIVE_FEED_STRICT=true, blockchain data never silently falls back to demo data.
APP_DATA_MODE="live"

# Mainnet execution interlock: mainnet READS are always allowed. Mainnet WRITES
# (transfers, approvals, swaps, contract writes) are rejected with
# MAINNET_EXECUTION_DISABLED unless this is explicitly set to true.
ALLOW_MAINNET="false"

# Server-side signing is disabled by default. Only enable for automation —
# normal user transfers/approvals/swaps are always signed by the user's wallet.
ENABLE_SERVER_SIGNER="false"

# Debug/raw RPC passthrough endpoints are not implemented in this MVP; reserved
# flag so any future debug tooling defaults to disabled in production.
ENABLE_DEBUG_RPC="false"

# 0x Swap API key (https://0x.org/docs/api) — required for real swap quotes.
ZEROX_API_KEY=""

# Feature flags for non-MVP modules. The operational MVP is: Dashboard, Wallet,
# Portfolio, Send, Swap, Transactions, Networks, Settings. Everything below
# defaults to disabled ("Coming Soon" in the UI) and their demo-data API routes
# return 404 while disabled.
FEATURE_RWA="false"
FEATURE_NFT="false"
FEATURE_LAUNCHPAD="false"
FEATURE_COPY_TRADING="false"
FEATURE_SPORTS="false"
FEATURE_DERIVATIVES="false"
FEATURE_MINING="false"
FEATURE_BANKING="false"
FEATURE_CUSTODY="false"

# If you still need a legacy compatibility alias, keep it disabled by default.
LEGACY_BLOCKCHAIN_PROVIDER=""
